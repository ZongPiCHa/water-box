<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <springProperty scope="context" name="EVENT_LOG_PATH"
                    source="water-box.logging.path" defaultValue="logs"/>
    <appender name="EVENT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${EVENT_LOG_PATH}/events.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${EVENT_LOG_PATH}/events.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- 逐条埋点及发布失败只写文件，避免控制台阻塞请求线程。 -->
    <logger name="com.waterbox.ingest.api.EventController" level="INFO" additivity="false">
        <appender-ref ref="EVENT_FILE"/>
    </logger>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
